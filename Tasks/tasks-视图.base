formulas:
  未命名: ""
views:
  - type: table
    name: 总task
    filters:
      and:
        - type == "task"
    order:
      - file.name
      - file.ctime
      - time_estimate
      - status
      - formula.未命名
    sort:
      - property: status
        direction: DESC
      - property: file.ctime
        direction: DESC
