formulas:
  未命名: time_estimate+完成时间
views:
  - type: table
    name: 总task
    filters:
      and:
        - type == "task"
    order:
      - file.name
      - file.ctime
      - time_estimate
      - status
      - formula.未命名
      - project
      - priority_score
    sort:
      - property: priority_score
        direction: DESC
      - property: file.ctime
        direction: DESC
      - property: status
        direction: DESC
    rowHeight: medium
  - type: table
    name: 雇佣工作
    filters:
      and:
        - type == "task"
        - project == "雇佣工作"
    order:
      - file.name
      - file.ctime
      - time_estimate
      - status
      - formula.未命名
      - project
    sort:
      - property: file.ctime
        direction: DESC
      - property: status
        direction: DESC
    cardSize: 330
    imageAspectRatio: 0.8
    rowHeight: medium
    columnSize:
      file.name: 280
  - type: table
    name: ai
    filters:
      and:
        - type == "task"
        - project == "AI"
    order:
      - file.name
      - file.ctime
      - time_estimate
      - status
      - formula.未命名
      - project
      - priority_score
    sort:
      - property: priority_score
        direction: DESC
      - property: status
        direction: DESC
      - property: file.ctime
        direction: DESC
      - property: formula.未命名
        direction: DESC
    rowHeight: medium
  - type: table
    name: 非done
    filters:
      and:
        - type == "task"
        - '!status.containsAny("done", "abort")'
    order:
      - file.name
      - file.ctime
      - time_estimate
      - status
      - formula.未命名
      - project
      - priority_score
    sort:
      - property: priority_score
        direction: DESC
      - property: file.ctime
        direction: DESC
      - property: formula.未命名
        direction: DESC
      - property: status
        direction: DESC
    rowHeight: medium
